# Переменные для продакшена (Timeweb Cloud)
# Скопируйте этот файл, назовите его .env и загрузите в App Platform:
#   Настройки → Редактировать → Переменные → «Загрузить из файла» (принимается только имя .env)
# ВАЖНО: .env в git не коммитится (см. .gitignore).

APP_NAME=Испытания
# сгенерируйте: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_64_СИМВОЛА

# --- База данных: реквизиты из панели Timeweb Cloud, вкладка «Подключение» ---
DB_HOST=ЗАМЕНИТЕ_НА_ХОСТ_БАЗЫ
DB_PORT=5432
DB_NAME=ЗАМЕНИТЕ_НА_ИМЯ_БД
DB_USER=ЗАМЕНИТЕ_НА_ПОЛЬЗОВАТЕЛЯ
DB_PASSWORD=ЗАМЕНИТЕ_НА_ПАРОЛЬ
# TLS включён у новых баз Timeweb по умолчанию
DB_SSLMODE=require

# Альтернатива пяти переменным выше — одна строка подключения:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Режим работы ---
# нейропроверка выключена (заглушка)
NEURAL_ENABLED=0
# ПЕРВЫЙ деплой: 1 — создаст демо-пользователей и демо-испытание
# затем поставьте 0 и передеплойте
SEED_DEMO=1
# запрет самостоятельной регистрации преподавателей (в проде 0 = запрещено)
ALLOW_TEACHER_SIGNUP=0
# cookie только по HTTPS (на Timeweb домен всегда https)
COOKIE_SECURE=1
SESSION_MAX_AGE=604800
